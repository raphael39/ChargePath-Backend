# systemd-Unit fuer RouteZero
#
# Installation auf dem Server:
#   sudo cp deploy/routezero.service /etc/systemd/system/routezero.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now routezero
#
# Logs anschauen:
#   sudo journalctl -u routezero -f

[Unit]
Description=RouteZero FastAPI Backend
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=routezero
Group=routezero
WorkingDirectory=/opt/routezero
Environment="PATH=/opt/routezero/.venv/bin:/usr/bin:/bin"
ExecStart=/opt/routezero/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

# Auto-Restart bei Crash
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Nur .cache muss read-write sein (requests-cache SQLite + Debug-Maps falls aktiviert).
# App-Logs gehen ueber stdout -> journald, kein File-Log noetig.
ReadWritePaths=/opt/routezero/.cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Resource-Limits (auf CX22 mit 4 GB RAM defensiv)
MemoryMax=2G
TasksMax=200

[Install]
WantedBy=multi-user.target
